# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3001

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/health_wellness
MONGO_FALLBACK_INMEMORY=false

# Auth
JWT_SECRET=change_me_super_secret
JWT_EXPIRES_IN=7d

# Optional email (Nodemailer)
EMAIL_FROM=no-reply@healthwellness.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Cron
CRON_ENABLED=true
